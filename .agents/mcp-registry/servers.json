{
  "mcpServers": {
    "context7": {
      "tier": "bring-your-key",
      "command": "mcp-npx",
      "args": [
        "@upstash/context7-mcp",
        "--api-key",
        "${UPSTASH_CONTEXT7_API_KEY}"
      ],
      "env": {
        "UPSTASH_CONTEXT7_API_KEY": "",
        "NO_COLOR": "1",
        "npm_config_loglevel": "silent"
      },
      "setup_hint": "Get key at https://upstash.com",
      "description": "Real-time library documentation resolver (Upstash Context7)",
      "category": "documentation"
    },
    "shadcn": {
      "tier": "zero-config",
      "command": "mcp-npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ],
      "env": {
        "NO_COLOR": "1",
        "npm_config_loglevel": "silent"
      },
      "description": "Direct Shadcn UI registry component discovery and addition",
      "category": "frontend"
    },
    "magic": {
      "tier": "bring-your-key",
      "command": "mcp-npx",
      "args": [
        "@21st-dev/magic@latest"
      ],
      "env": {
        "MAGIC_API_KEY": "",
        "NO_COLOR": "1",
        "npm_config_loglevel": "silent"
      },
      "setup_hint": "Get free key at https://21st.dev",
      "description": "21st.dev Magic UI design inspiration, component search & generation",
      "category": "frontend"
    },
    "github": {
      "tier": "bring-your-key",
      "command": "mcp-npx",
      "args": [
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_TOKEN": "",
        "NO_COLOR": "1",
        "npm_config_loglevel": "silent"
      },
      "setup_hint": "Get PAT at https://github.com/settings/tokens",
      "description": "GitHub issues, pull requests, repository search & automation",
      "category": "vcs"
    },
    "playwright": {
      "tier": "zero-config",
      "command": "mcp-npx",
      "args": [
        "@playwright/mcp"
      ],
      "env": {
        "NO_COLOR": "1",
        "npm_config_loglevel": "silent"
      },
      "description": "Headless browser automation, visual snapshots & E2E web testing",
      "category": "testing"
    },
    "supabase": {
      "tier": "bring-your-key",
      "command": "mcp-npx",
      "args": [
        "@supabase/mcp-server-supabase"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "",
        "SUPABASE_PROJECT_REF": "",
        "NO_COLOR": "1",
        "npm_config_loglevel": "silent"
      },
      "setup_hint": "Get tokens at https://supabase.com/dashboard/account/tokens",
      "description": "Supabase project management, database migrations & SQL execution",
      "category": "database"
    },
    "sentry": {
      "tier": "bring-your-key",
      "command": "mcp-npx",
      "args": [
        "@sentry/mcp-server",
        "--access-token",
        "${SENTRY_AUTH_TOKEN}"
      ],
      "env": {
        "SENTRY_AUTH_TOKEN": "",
        "SENTRY_ORG": "",
        "NO_COLOR": "1",
        "npm_config_loglevel": "silent"
      },
      "setup_hint": "Get auth token at https://sentry.io/settings/account/api/auth-tokens/",
      "description": "Sentry error telemetry, performance traces & crash diagnostic queries",
      "category": "observability"
    },
    "neon": {
      "tier": "bring-your-key",
      "command": "mcp-npx",
      "args": [
        "@neondatabase/mcp-server-neon"
      ],
      "env": {
        "NEON_API_KEY": "",
        "NO_COLOR": "1",
        "npm_config_loglevel": "silent"
      },
      "setup_hint": "Get API key at https://console.neon.tech/app/settings/api-keys",
      "description": "Neon serverless Postgres branching, SQL queries & connection pooling",
      "category": "database"
    },
    "chrome-devtools": {
      "tier": "zero-config",
      "command": "mcp-npx",
      "args": [
        "chrome-devtools-mcp"
      ],
      "env": {
        "NO_COLOR": "1",
        "npm_config_loglevel": "silent"
      },
      "description": "Live Chrome DOM inspection, Lighthouse audits & performance traces",
      "category": "browser"
    },
    "serena": {
      "tier": "zero-config",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena.git",
        "serena",
        "start-mcp-server",
        "--open-web-dashboard",
        "false"
      ],
      "description": "Semantic AST symbol navigation, project memory & deep refactoring",
      "category": "code-intelligence"
    },
    "docker-gateway": {
      "tier": "zero-config",
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "/var/run/docker.sock:/var/run/docker.sock",
        "mcp/docker"
      ],
      "description": "Docker container lifecycle, sandbox builds & image inspection",
      "category": "containers"
    },
    "reui": {
      "tier": "zero-config",
      "serverUrl": "https://mcp.reui.io",
      "description": "ReUI 1,105+ React components, UI blocks & shadcn registry",
      "category": "frontend"
    }
  }
}
